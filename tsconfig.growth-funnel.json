{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "scripts/verify-growth-funnel-contract.ts",
    "src/lib/growth-analytics.ts"
  ]
}
