generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ReadingResult {
  id        String   @id @default(uuid())
  data      String
  metadata  String?
  createdAt DateTime @default(now())
  chatSession ChatSession?
}

model ChatSession {
  id              String        @id @default(uuid())
  readingResultId String        @unique
  readingResult   ReadingResult @relation(fields: [readingResultId], references: [id])
  credits         Int           @default(1) // Default 1 free question
  shareRewardClaimed Boolean    @default(false) // Track if share reward was given
  messages        ChatMessage[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model ChatMessage {
  id            String      @id @default(uuid())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id])
  role          String      // 'user' | 'assistant'
  content       String
  createdAt     DateTime    @default(now())
}

model PromotionCode {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  discount    Int      @default(100)
  maxUses     Int      @default(50)
  usedCount   Int      @default(0)
  expiresAt   DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  redemptions PromoRedemption[]
}

model PromoRedemption {
  id          String        @id @default(uuid())
  promoCodeId String
  promoCode   PromotionCode @relation(fields: [promoCodeId], references: [id])
  readingId   String?
  userAgent   String?
  createdAt   DateTime      @default(now())
}

model Review {
  id          String   @id @default(uuid())
  readingId   String?
  nickname    String
  rating      Int
  content     String
  isApproved  Boolean  @default(false)
  isPromoUser Boolean  @default(false)
  createdAt   DateTime @default(now())
}
