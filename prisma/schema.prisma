generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model ReadingResult {
  id        String   @id @default(uuid())
  data      String
  metadata  String?
  createdAt DateTime @default(now())
  chatSession ChatSession?
}

model ChatSession {
  id              String        @id @default(uuid())
  readingResultId String        @unique
  readingResult   ReadingResult @relation(fields: [readingResultId], references: [id])
  credits         Int           @default(1) // Default 1 free question
  messages        ChatMessage[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model ChatMessage {
  id            String      @id @default(uuid())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id])
  role          String      // 'user' | 'assistant'
  content       String
  createdAt     DateTime    @default(now())
}
