generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ReadingResult {
  id        String   @id @default(uuid())
  data      String
  metadata  String?
  createdAt DateTime @default(now())
  chatSession ChatSession?
  
  // Viral Loop Fields
  invitationCode String? @unique
  invitationCount Int @default(0)

  // Link to User
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("USER") // USER | ADMIN
  accounts      Account[]
  sessions      Session[]
  readings      ReadingResult[]
  
  // Custom Fields
  marketingConsent Boolean @default(false)
  
  // Match Sessions
  hostedMatches MatchSession[] @relation("Host")
  guestMatches  MatchSession[] @relation("Guest")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ChatSession {
  id              String        @id @default(uuid())
  readingResultId String        @unique
  readingResult   ReadingResult @relation(fields: [readingResultId], references: [id])
  credits         Int           @default(1) // Default 1 free question
  shareRewardClaimed Boolean    @default(false) // Track if share reward was given
  messages        ChatMessage[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model ChatMessage {
  id            String      @id @default(uuid())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id])
  role          String      // 'user' | 'assistant'
  content       String
  createdAt     DateTime    @default(now())

  @@index([chatSessionId])
}

model PromotionCode {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  discount    Int      @default(100)
  maxUses     Int      @default(50)
  usedCount   Int      @default(0)
  expiresAt   DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  redemptions PromoRedemption[]
}

model PromoRedemption {
  id          String        @id @default(uuid())
  promoCodeId String
  promoCode   PromotionCode @relation(fields: [promoCodeId], references: [id])
  readingId   String?
  userAgent   String?
  email       String?
  createdAt   DateTime      @default(now())

  @@unique([promoCodeId, email])
  @@index([promoCodeId])
}

model Review {
  id          String   @id @default(uuid())
  readingId   String?
  nickname    String
  rating      Int
  content     String
  isApproved  Boolean  @default(false)
  isPromoUser Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Payment {
  id            String   @id @default(uuid())
  orderId       String   @unique // Stripe Session ID or Toss Order ID
  amount        Int
  currency      String
  status        String   // 'DONE', 'CANCELED', 'WAITING_FOR_DEPOSIT'
  method        String   // 'STRIPE', 'TOSS'
  receiptUrl    String?
  customerEmail String?
  readingId     String?
  metadata      String?  // JSON string for extra data
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([readingId])
}

model MatchSession {
  id           String   @id @default(uuid())
  hostName     String
  hostBirth    DateTime
  hostTimezone String   @default("Asia/Seoul")
  guestName    String?
  guestBirth   DateTime?
  guestTimezone String?
  score        Int?     // Calculated after guest joins
  isUnlocked   Boolean  @default(false)
  unlockedAt   DateTime?
  paymentId    String?  // Link to Payment if paid
  metadata     String?  // JSON for extra data (e.g., detailed scores)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Link to Users (Optional)
  hostUserId   String?
  hostUser     User?    @relation("Host", fields: [hostUserId], references: [id])
  guestUserId  String?
  guestUser    User?    @relation("Guest", fields: [guestUserId], references: [id])

  @@index([paymentId])
  @@index([hostUserId])
  @@index([guestUserId])
}

model FollowUpJob {
  id           String   @id @default(uuid())
  readingId    String
  email        String
  stage        String   // H48 | D7
  scheduledFor DateTime
  status       String   @default("PENDING") // PENDING | SENT | FAILED | CANCELED
  attempts     Int      @default(0)
  sentAt       DateTime?
  lastError    String?
  metadata     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([readingId, stage])
  @@index([status, scheduledFor])
  @@index([readingId])
}

model GrowthEvent {
  id           String   @id @default(uuid())
  event        String
  readingId    String?
  referralCode String?
  channel      String?
  metadata     String?
  createdAt    DateTime @default(now())

  @@index([event, createdAt])
  @@index([readingId])
  @@index([referralCode])
}

model QuotaUsageDaily {
  id         String   @id @default(uuid())
  day        DateTime
  identifier String
  action     String
  used       Int      @default(0)
  limit      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([day, identifier, action])
  @@index([identifier, day])
}

model UsageCounterDaily {
  id        String   @id @default(uuid())
  day       DateTime
  provider  String
  metric    String
  count     Int      @default(0)
  amount    Int      @default(0) // Optional numeric amount (tokens, cents, etc)
  metadata  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([day, provider, metric])
  @@index([provider, day])
}

model OpsAlert {
  id              String   @id @default(uuid())
  source          String
  alertKey        String
  severity        String
  title           String
  message         String
  details         String?
  status          String   @default("OPEN") // OPEN | ACK | RESOLVED
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  occurrenceCount Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([source, alertKey])
  @@index([severity, lastSeenAt])
  @@index([status, lastSeenAt])
}

