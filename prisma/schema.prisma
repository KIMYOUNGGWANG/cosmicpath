generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ReadingResult {
  id        String   @id @default(uuid())
  data      String
  metadata  String?
  createdAt DateTime @default(now())
  chatSession ChatSession?
}

model ChatSession {
  id              String        @id @default(uuid())
  readingResultId String        @unique
  readingResult   ReadingResult @relation(fields: [readingResultId], references: [id])
  credits         Int           @default(1) // Default 1 free question
  shareRewardClaimed Boolean    @default(false) // Track if share reward was given
  messages        ChatMessage[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model ChatMessage {
  id            String      @id @default(uuid())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id])
  role          String      // 'user' | 'assistant'
  content       String
  createdAt     DateTime    @default(now())

  @@index([chatSessionId])
}

model PromotionCode {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  discount    Int      @default(100)
  maxUses     Int      @default(50)
  usedCount   Int      @default(0)
  expiresAt   DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  redemptions PromoRedemption[]
}

model PromoRedemption {
  id          String        @id @default(uuid())
  promoCodeId String
  promoCode   PromotionCode @relation(fields: [promoCodeId], references: [id])
  readingId   String?
  userAgent   String?
  email       String?
  createdAt   DateTime      @default(now())

  @@unique([promoCodeId, email])
  @@index([promoCodeId])
}

model Review {
  id          String   @id @default(uuid())
  readingId   String?
  nickname    String
  rating      Int
  content     String
  isApproved  Boolean  @default(false)
  isPromoUser Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Payment {
  id            String   @id @default(uuid())
  orderId       String   @unique // Stripe Session ID or Toss Order ID
  amount        Int
  currency      String
  status        String   // 'DONE', 'CANCELED', 'WAITING_FOR_DEPOSIT'
  method        String   // 'STRIPE', 'TOSS'
  receiptUrl    String?
  customerEmail String?
  readingId     String?
  metadata      String?  // JSON string for extra data
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([readingId])
}

model MatchSession {
  id           String   @id @default(uuid())
  hostName     String
  hostBirth    DateTime
  hostTimezone String   @default("Asia/Seoul")
  guestName    String?
  guestBirth   DateTime?
  guestTimezone String?
  score        Int?     // Calculated after guest joins
  isUnlocked   Boolean  @default(false)
  unlockedAt   DateTime?
  paymentId    String?  // Link to Payment if paid
  metadata     String?  // JSON for extra data (e.g., detailed scores)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([paymentId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
}
